meta {
  name: Create job - oversized body
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/jobs
  body: json
  auth: none
}

body:json {
  {
    "title": "Oversized",
    "company": "Acme Corp",
    "description": ""
  }
}

docs {
  The request body exceeds 50 KB (MAX_BODY_BYTES = 51200 bytes). The
  BodySizeLimitMiddleware short-circuits before the body is parsed, counting the
  actual bytes streamed rather than trusting Content-Length.

  Expected: 422 Unprocessable Entity
  Body: Pydantic-shaped envelope, detail[0].type = "too_large".
}
